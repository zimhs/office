# 맥·아이패드 공용 Streamlit Cloud URL
# (앱 secrets에 dashboard_cloud_url 이 있으면 그게 우선)
dashboard_cloud_url = "https://office-g8ryabkapprkpjmfwa5aypw.streamlit.app"

# Cloud — Google Drive「dashboard 복사본/uproad」폴더 ID (재시작 시 자동 로드)
# Drive 웹에서 uproad 폴더 URL: .../folders/FOLDER_ID
drive_uproad_folder_id = ""

# (택1) 서비스 계정 — uproad 폴더를 서비스 계정 이메일과 공유(뷰어)
