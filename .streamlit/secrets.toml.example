# (택1) API 키 — uproad 폴더가 링크 공유(보기)일 때
# google_drive_api_key = ""

# 단가인상 탭 — 다음메일 SMTP 자동발송
# ※ Mac 로컬: 공문 탭「SMTP 계정 설정」에서 저장해도 됨
#    (uploaded_cache/price_increase/smtp_local.toml)
# 다음메일: 설정 → POP/IMAP 설정 → 「POP3/IMAP 사용」켜기
smtp_provider = "daum"
smtp_host = "smtp.daum.net"
smtp_port = 465
smtp_user = "아이디@daum.net"
smtp_password = "메일비밀번호"
smtp_from_name = "신일가스"
# Mac에서 CERTIFICATE_VERIFY_FAILED 나면 "0"으로
smtp_ssl_verify = "0"

